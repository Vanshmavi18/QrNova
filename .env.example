# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Connection String
# Local MongoDB or MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/qrnova
MONGODB_URI=mongodb://127.0.0.1:27017/qrnova

# JWT Authentication
JWT_SECRET=qrnova_jwt_super_secret_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Brevo (formerly Sendinblue) Transactional Email API for Gmail OTP
# Get your API key from https://app.brevo.com/settings/keys/api
# Note: For Brevo Free accounts, BREVO_SENDER_EMAIL must be a verified sender in your Brevo account
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_email@gmail.com
BREVO_SENDER_NAME=QrNova Security

# Optional: Google Gemini API for advanced AI-Readable content analysis
GEMINI_API_KEY=
